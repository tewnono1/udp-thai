# ==========================================
echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}\e[1;33m          ⚡ SSLAB UDP PANEL V2.0 ⚡         \e[0m${CYAN}║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
echo ""

echo -e "${GREEN}==================================================${NC}"
echo -e " \033[1;36m               📋 เมนูจัดการระบบหลัก            \033[0m"
echo -e "${GREEN}==================================================${NC}"
echo -e " ${WHITE} [1]${NC} ➔ เพิ่มผู้ใช้งานใหม่"
echo -e " ${WHITE} [2]${NC} ➔ แสดงผู้ใช้งานทั้งหมด"
echo -e " ${WHITE} [3]${NC} ➔ แก้ไขข้อมูลผู้ใช้งาน"
echo -e " ${WHITE} [4]${NC} ➔ ลบผู้ใช้งาน"
echo -e " ${WHITE} [5]${NC} ➔ เช็กสถานะผู้ใช้งาน (วันหมดอายุ)"
echo -e " ${WHITE} [6]${NC} ➔ เช็กปริมาณเน็ตที่ใช้ (GB/MB)"
