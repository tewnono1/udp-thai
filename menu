        echo -e "\n${YELLOW} [!] กำลังรีสตาร์ทระบบ กรุณารอสักครู่...${NC}"
        sleep 2
        reboot 
        ;;
    0) 
        echo -e "\n${GREEN} ออกจากโปรแกรมเรียบร้อยแล้ว ขอบคุณครับ!${NC}"
        exit 
        ;;
    *) 
        echo -e "\n${RED} [✘] ข้อผิดพลาด: เลือกเมนูไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง!${NC}"
        sleep 1.5 
        menu 
        ;;
esac
