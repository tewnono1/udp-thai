        echo -e " ${WHITE}• ขอขอบคุณสำหรับการใช้งานระบบของเราครับ!${NC}"
        echo ""
        echo -e "${GREEN}==================================================${NC}"
        echo -ne "${CYAN} กด Enter เพื่อกลับไปที่เมนูหลัก...${NC}"
        read && menu 
        ;;
