echo -e " ${WHITE}[11]${NC} ➔ รีสตาร์ทระบบ"
echo -e " ${WHITE} [0]${NC} ➔ ออกจากเมนู"
echo -e "${GREEN}==================================================${NC}"
echo ""
echo -ne "${CYAN} • เลือกเมนูที่คุณต้องการใช้งาน [0-11] : ${NC}"
read option

case $option in
    1) cd /etc/Sslablk/system && ./Adduser.sh ;;
    2) cd /etc/Sslablk/system && ./Userlist.sh ;;
    3) cd /etc/Sslablk/system && ./ChangeUser.sh ;;
    4) cd /etc/Sslablk/system && ./DelUser.sh ;;
    5) cd /etc/Sslablk/system && ./infousers ;;
    6) cd /etc/Sslablk/system && ./UserUsage.sh ;;
    7) neofetch ;;
    8) cd /etc/Sslablk/system && ./torrent.sh ;;
    9) cd /etc/Sslablk/system && ./RemoveScript.sh ;;
    10) 
        clear
        echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║${NC}\e[1;33m             ★ ABOUT SSLAB SYSTEM ★           \e[0m${CYAN}║${NC}"
        echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e " ${WHITE}• สคริปต์นี้พัฒนาและปรับปรุงระบบเมนูภาษาไทยโดย${NC}"
